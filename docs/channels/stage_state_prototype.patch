+    // The count-independent part of a stage, built once per (S, R) and shared
+    // by every channel count (prototype: the audit's design-2 remedy).
+    template <tap::dsp::sample_type S, rational_ratio R>
+    struct stage_table {
+        using B = basic_stage<S, R, 0>;
+        std::size_t taps = 0, row_len = 0;
+        std::vector<typename B::coeff> rows;
+        std::array<std::size_t, B::k_rows> first{}, count{};
+    };
+    namespace detail_proto {
+        template <tap::dsp::sample_type S, rational_ratio R>
+        struct ops {
+            using B = basic_stage<S, R, 0>;
+            /// Records the nonzero span [first, first + count) of row r.
+        static void trim_into(stage_table<S, R>& tb, std::size_t r) noexcept {
+            const typename B::coeff* row   = tb.rows.data() + r * tb.row_len;
+            std::size_t  first = 0;
+            while (first < tb.row_len && row[first] == static_cast<typename B::coeff>(0)) {
+                ++first;
+            }
+            std::size_t last = tb.row_len;
+            while (last > first && row[last - 1] == static_cast<typename B::coeff>(0)) {
+                --last;
+            }
+            tb.first[r] = first;
+            tb.count[r] = last - first;
+        }
+        static void build_into(stage_table<S, R>& tb, const std::vector<double>& h) {
+            const std::size_t n = h.size();
+            if constexpr (B::k_is_decimator) {
+                // The whole filter at sum 1, quantized as ONE row so the
+                // fixed-point sum lands on unity exactly, then scattered to
+                // the M branches (branch j: taps j + s M, s ascending =
+                // older, so the row is stored reversed: oldest first). In
+                // Q15 each branch of the unscaled design (every branch of a
+                // Nyquist filter sums to 1) is quantized on its own at unity
+                // instead, and the 1 / M is applied in the finalize.
+                std::vector<typename B::coeff> q(n);
+                if constexpr (B::k_branch_quantized) {
+                    std::vector<double> branch((n + B::k_down - 1) / B::k_down);
+                    std::vector<typename B::coeff>  qb(branch.size());
+                    for (std::size_t j = 0; j < B::k_down; ++j) {
+                        const std::size_t len = (n - j + B::k_down - 1) / B::k_down; // taps j, j + M, ...
+                        for (std::size_t s = 0; s < len; ++s) {
+                            branch[s] = h[j + s * B::k_down];
+                        }
+                        tap::dsp::quantize_row_preserving_sum<S>(std::span<const double>(branch.data(), len),
+                                                                 std::span<typename B::coeff>(qb.data(), len));
+                        for (std::size_t s = 0; s < len; ++s) {
+                            q[j + s * B::k_down] = qb[s];
+                        }
+                    }
+                }
+                else {
+                    std::vector<double> scaled(n);
+                    for (std::size_t i = 0; i < n; ++i) {
+                        scaled[i] = h[i] / static_cast<double>(B::k_down);
+                    }
+                    tap::dsp::quantize_row_preserving_sum<S>(scaled, q);
+                }
+                tb.row_len = (n + B::k_down - 1) / B::k_down; // 2 m
+                tb.rows.assign(B::k_rows * tb.row_len, static_cast<typename B::coeff>(0));
+                for (std::size_t j = 0; j < B::k_rows; ++j) {
+                    const std::size_t len = (n - j + B::k_down - 1) / B::k_down; // taps j, j + M, ...
+                    // Right-aligned to the newest sample (s = 0 at the row's
+                    // end): a branch one tap short pads at its OLD end.
+                    for (std::size_t s = 0; s < len; ++s) {
+                        tb.rows[j * tb.row_len + (tb.row_len - 1 - s)] = q[j + s * B::k_down];
+                    }
+                    trim_into(tb, j);
+                }
+            }
+            else {
+                tb.row_len = (n + B::k_up - 1) / B::k_up; // T = ceil(N / L)
+                tb.rows.assign(B::k_rows * tb.row_len, static_cast<typename B::coeff>(0));
+                std::vector<double> row(tb.row_len);
+                std::vector<typename B::coeff>  q(tb.row_len);
+                for (std::size_t p = 0; p < B::k_rows; ++p) {
+                    double sum = 0.0;
+                    for (std::size_t t = 0; t < tb.row_len; ++t) {
+                        const std::size_t i    = p + t * B::k_up;
+                        const double      v    = i < n ? h[i] : 0.0;
+                        row[tb.row_len - 1 - t] = v;
+                        sum += v;
+                    }
+                    if constexpr (!B::traits::k_is_up) {
+                        // A mixed ratio going down: the L phases are not the
+                        // design's M branches; normalize each to DC gain 1
+                        // (B::k_table_gain in Q15, divided out in the rounding).
+                        for (auto& v : row) {
+                            v = v / sum * static_cast<double>(B::k_table_gain);
+                        }
+                    }
+                    tap::dsp::quantize_row_preserving_sum<S>(row, q);
+                    for (std::size_t t = 0; t < tb.row_len; ++t) {
+                        tb.rows[p * tb.row_len + t] = q[t];
+                    }
+                    trim_into(tb, p);
+                }
+            }
+        }
+        };
+        template <tap::dsp::sample_type S, rational_ratio R>
+        TAP_SR_RATIONAL_NOINLINE stage_table<S, R> make_stage_table(const profile& p) {
+            stage_table<S, R> t;
+            const std::vector<double> h = design_stage<R>(p);
+            t.taps = h.size();
+            ops<S, R>::build_into(t, h);
+            return t;
+        }
+    }
